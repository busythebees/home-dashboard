+export async function getLifecycleOutboxHealthIDB() {
+    await dbReady;
+    const tx = db.transaction(["lifecycle_outbox", "lifecycle_outbox_meta"], "readonly");
+    const [storedStats, cursor] = await Promise.all([
+        tx.objectStore("lifecycle_outbox_meta").get("stats"),
+        tx.objectStore("lifecycle_outbox").openCursor()
+    ]);
+    const stats = requireLifecycleOutboxStats(storedStats);
+    const oldest = cursor == null ? undefined : validateLifecycleOutboxRecord({
+        id: Number(cursor.primaryKey),
+        ...cursor.value
+    });
+    await tx.done;
+    return { count: stats.count, bytes: stats.bytes, oldest_captured_at: oldest?.captured_at ?? null };
+}
