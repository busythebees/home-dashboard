@@ -0,0 +1,83 @@
+/*
+ * Vencord, a Discord client mod
+ * Copyright (c) 2024 Vendicated and contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+// Modified 2026-09-26 by SeaL773: publish bounded, content-free collector
+// outbox health without coupling health I/O to lifecycle durability.
+
+import { Native } from ".";
+import { getLifecycleOutboxHealthIDB } from "./db";
+import { MAX_LIFECYCLE_OUTBOX_BYTES, MAX_LIFECYCLE_OUTBOX_EVENTS } from "./lifecycleOutbox";
+
+const HEALTH_INTERVAL_MS = 30_000;
+let timer: ReturnType<typeof setInterval> | null = null;
+let lastSuccessfulDrainAt: string | null = null;
+let outboxFailureReason: "outbox-backlog" | "outbox-full" | "outbox-enqueue-rejected" | "outbox-corrupt" | null = null;
+
+function boundedReason(error: unknown) {
+    const name = error instanceof Error ? error.name : "";
+    const message = error instanceof Error ? error.message : "";
+    if (name === "LifecycleOutboxCapacityError") return "outbox-full" as const;
+    if (/malformed|corrupt|contradictory|statistics/i.test(message)) return "outbox-corrupt" as const;
+    return "outbox-enqueue-rejected" as const;
+}
+
+export function noteCollectorOutboxFailure(error: unknown) {
+    outboxFailureReason = boundedReason(error);
+}
+
+export function noteCollectorDrainFailure(error: unknown) {
+    outboxFailureReason = /malformed|corrupt|contradictory|statistics/i.test(
+        error instanceof Error ? error.message : ""
+    ) ? "outbox-corrupt" : "outbox-backlog";
+}
+
+export function noteCollectorDrainSuccess() {
+    lastSuccessfulDrainAt = new Date().toISOString();
+    outboxFailureReason = null;
+}
+
+export async function publishCollectorHealth() {
+    let stats: { count: number; bytes: number; oldest_captured_at: string | null; };
+    try {
+        stats = await getLifecycleOutboxHealthIDB();
+    } catch {
+        stats = { count: 0, bytes: 0, oldest_captured_at: null };
+        outboxFailureReason = "outbox-corrupt";
+    }
+    const reason = outboxFailureReason ??
+        (stats.count >= MAX_LIFECYCLE_OUTBOX_EVENTS || stats.bytes >= MAX_LIFECYCLE_OUTBOX_BYTES
+            ? "outbox-full" : null);
+    try {
+        await Native.writeCollectorHealth(JSON.stringify({
+            schema_version: 1,
+            component_id: "vesktop-collector",
+            reported_at: new Date().toISOString(),
+            alive: true,
+            outbox_entry_count: stats.count,
+            outbox_byte_usage: stats.bytes,
+            outbox_entry_capacity_percent: Math.min(100, stats.count * 100 / MAX_LIFECYCLE_OUTBOX_EVENTS),
+            outbox_byte_capacity_percent: Math.min(100, stats.bytes * 100 / MAX_LIFECYCLE_OUTBOX_BYTES),
+            oldest_pending_at: stats.oldest_captured_at,
+            last_successful_drain_at: lastSuccessfulDrainAt,
+            reason_code: reason
+        }));
+    } catch {
+        // Health publication is deliberately independent of enqueue, append,
+        // acknowledgement, and IndexedDB durability.
+    }
+}
+
+export function startCollectorHealthPublisher() {
+    if (timer != null) return;
+    void publishCollectorHealth();
+    timer = setInterval(() => void publishCollectorHealth(), HEALTH_INTERVAL_MS);
+}
+
+export function stopCollectorHealthPublisher() {
+    if (timer == null) return;
+    clearInterval(timer);
+    timer = null;
+}
