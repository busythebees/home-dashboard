+export function writeCollectorHealth(_event: IpcMainInvokeEvent, healthJson: string) {
+    const writeHealth = async () => {
+        if (typeof healthJson !== "string" || Buffer.byteLength(healthJson, "utf8") > COLLECTOR_HEALTH_MAX_BYTES)
+            throw new Error("Collector health document is invalid.");
+        const value: unknown = JSON.parse(healthJson);
+        if (!isRecord(value) || value.schema_version !== 1 || value.component_id !== "vesktop-collector")
+            throw new Error("Collector health document identity is invalid.");
+        const logsDir = await getLogsDir();
+        await ensureDirectoryExists(logsDir);
+        const target = path.join(logsDir, COLLECTOR_HEALTH_FILENAME);
+        const temporary = `${target}.tmp-${process.pid}-${randomUUID()}`;
+        try {
+            await writeFile(temporary, healthJson, { encoding: "utf8", mode: 0o600, flag: "wx" });
+            await rename(temporary, target);
+        } catch (error) {
+            try { await unlink(temporary); } catch (cleanupError) {
+                if (!isMissingFileError(cleanupError)) throw cleanupError;
+            }
+            throw error;
+        }
+    };
+    const pending = collectorHealthWriteQueue.then(writeHealth, writeHealth);
+    collectorHealthWriteQueue = pending.catch(() => undefined);
+    return pending;
+}
